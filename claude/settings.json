  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/hanne/.claude/learning/ll.py hook SessionStart",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python C:/Users/hanne/.claude/learning/ll.py index",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/hanne/.claude/learning/ll.py hook UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/hanne/.claude/learning/ll.py hook PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/hanne/.claude/learning/ll.py hook PostToolUseFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/hanne/.claude/learning/ll.py hook Stop",
            "timeout": 1800,
            "statusMessage": "Lernloop und Prüf-Gate"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/hanne/.claude/learning/ll.py hook PreCompact",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/hanne/.claude/learning/ll.py hook SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  },
